{
  "name": "MQTT2IR",
  "version": "latest",
  "slug": "mqtt2ir",
  "description": "Web UI for IR bridges with learning and MQTT auto-discovery",
  "url": "https://github.com/spasemice/mqtt2ir",
  "image": "ghcr.io/spasemice/mqtt2ir-ha-app/{arch}",
  "arch": ["aarch64", "amd64", "armv7"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:remote",
  "panel_title": "MQTT2IR",
  "uart": true,
  "udev": true,
  "options": {
    "mqtt_broker": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_pass": "",
    "log_level": "INFO"
  },
  "schema": {
    "mqtt_broker": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_user": "str?",
    "mqtt_pass": "password?",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)"
  }
}
